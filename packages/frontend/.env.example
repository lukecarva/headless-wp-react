# The values below are for local development. Real deployments must set
# NEXT_PUBLIC_WORDPRESS_URL and NEXT_PUBLIC_GRAPHQL_ENDPOINT explicitly. The
# localhost defaults in lib/defaults.js are only a local convenience.

# Public WordPress base URL (used for admin links and image host allow-listing).
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8888

# WPGraphQL endpoint the frontend queries.
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8888/graphql

# ISR revalidation interval, in seconds.
REVALIDATE_SECONDS=60

# Shared secret for the on-demand revalidation webhook (POST /api/revalidate,
# header `x-revalidate-secret`). Leave unset to disable the webhook.
REVALIDATE_SECRET=change-me

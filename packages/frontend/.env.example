# The values below are for local development. Real deployments must set the
# NEXT_PUBLIC_* variables explicitly; the localhost defaults in lib/defaults.js
# are only a local convenience.

# --- Public (inlined into the client bundle at build time) ---

# WordPress base URL (used for admin links and image host allow-listing).
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8888

# WPGraphQL endpoint the frontend queries.
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8888/graphql

# Public URL of the frontend itself, used for canonical, Open Graph and sitemap
# URLs. Set it on any real deployment, or those URLs point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-side only (never exposed to the browser) ---

# ISR revalidation interval, in seconds.
REVALIDATE_SECONDS=60

# Shared secret for the on-demand revalidation webhook (POST /api/revalidate,
# header `x-revalidate-secret`). Must match the plugin's HWR_REVALIDATE_SECRET.
# Leave unset to disable the webhook.
REVALIDATE_SECRET=change-me

# --- Draft preview (all of these are needed to preview drafts on the frontend) ---

# Shared secret used to verify preview tokens from WordPress. Must match the
# plugin's HWR_PREVIEW_SECRET. Leave unset and /api/draft returns 401.
WP_PREVIEW_SECRET=change-me

# WordPress Application Password used to read drafts over the REST preview route.
# Create one in wp-admin under Users > Profile > Application Passwords.
WP_APP_USER=admin
WP_APP_PASSWORD=

# --- Observability (optional) ---

# Sentry DSN for server-side error monitoring. Unset means Sentry stays inert.
SENTRY_DSN=
